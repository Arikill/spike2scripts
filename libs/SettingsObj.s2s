object SettingsObj
    var path$;
    var name$;
    var view%;
    
    var waveAvgView%;
    var psthView%;
    var stimAvgView%;
    
    var waveAvgFlag%;
    var psthFlag%;
    var stimAvgFlag%;
    
    var temp$;
    
    var folder$;
    var dB%;
    var Hz%;
    var msPD%;
    var pulses%;
    var pps%;
    var nA;
    var stimTrigChan%;
    var stimChan%;
    var waveChan%;
    var spksTrigChan%;
    var avgDuration;
    var waveSamples%;
    var nbins%;
    var psthDuration;
    var c12%;
    var c34%;
    var c56%;
    var c78%;
    var c90%;
    var version$;
    
    '' Utility functions
    func setPath(path$) self.path$ := path$ end;
    func setName(name$) self.name$ := name$ end;
    func openFile() 
    self.view% := FileOpen(self.path$+"//"+self.name$, 17, 2);
    return self.view%; 
    end
    func closeFile() View(self.view%);FileSave();FileClose(); end;
    
    '' Getter & Write functions
    func get(col%, row%)
    View(self.view%);
    return GrdGet(self.temp$, col%, row%);
    end
    
    func write(str$, col%, row%)
    View(self.view%);
    return GrdSet(str$, col%, row%)
    end
    
    '' folder functions
    func set_folder(x$) self.folder$ := x$ end;
    func get_folder(col%, row%) get(col%, row%); set_folder(self.temp$); end;
    func write_folder(col%, row%) return write(self.folder$, col%, row%) end;
    
    '' dB functions
    func set_dB(x$) self.dB% := Val(x$) end;
    func get_dB(col%, row%) get(col%, row%); set_dB(self.temp$); end;
    func write_dB(col%, row%) return write(Str$(self.dB%), col%, row%) end;
    
    '' Hz functions
    func set_Hz(x$) self.Hz% := Val(x$) end;
    func get_Hz(col%, row%) get(col%, row%); set_Hz(self.temp$); end;
    func write_Hz(col%, row%) return write(Str$(self.Hz%), col%, row%) end;
    
    '' msPD functions
    func set_msPD(x$) self.msPD% := Val(x$) end;
    func get_msPD(col%, row%) get(col%, row%); set_msPD(self.temp$); end;
    func write_msPD(col%, row%) return write(Str$(self.msPD%), col%, row%) end;
    
    '' pulses functions
    func set_pulses(x$) self.pulses% := Val(x$) end;
    func get_pulses(col%, row%) get(col%, row%); set_pulses(self.temp$); end;
    func write_pulses(col%, row%) return write(Str$(self.pulses%), col%, row%) end;
    
    '' pps functions
    func set_pps(x$) self.pps% := Val(x$) end;
    func get_pps(col%, row%) get(col%, row%); set_pps(self.temp$); end;
    func write_pps(col%, row%) return write(Str$(self.pps%), col%, row%) end;
    
    '' nA functions
    func set_nA(x$) self.nA := Val(x$) end;
    func get_nA(col%, row%) get(col%, row%); set_nA(self.temp$); end;
    func write_nA(col%, row%) return write(Str$(self.nA), col%, row%) end;
    
    '' stimTrigChan functions
    func set_stimTrigChan(x$) self.stimTrigChan% := Val(x$) end;
    func get_stimTrigChan(col%, row%) get(col%, row%); set_stimTrigChan(self.temp$); end;
    func write_stimTrigChan(col%, row%) return write(Str$(self.stimTrigChan%), col%, row%) end;
    
    '' spksTrigChan functions
    func set_spksTrigChan(x$) self.spksTrigChan% := Val(x$) end;
    func get_spksTrigChan(col%, row%) get(col%, row%); set_spksTrigChan(self.temp$); end;
    func write_spksTrigChan(col%, row%) return write(Str$(self.spksTrigChan%), col%, row%) end;
    
    '' stimChan functions
    func set_stimChan(x$) self.stimChan% := Val(x$) end;
    func get_stimChan(col%, row%) get(col%, row%); set_stimChan(self.temp$); end;
    func write_stimChan(col%, row%) return write(Str$(self.stimChan%), col%, row%) end;
    
    '' waveChan functions
    func set_waveChan(x$) self.waveChan% := Val(x$) end;
    func get_waveChan(col%, row%) get(col%, row%); set_waveChan(self.temp$); end;
    func write_waveChan(col%, row%) return write(Str$(self.waveChan%), col%, row%) end;
    
    '' avgDuration functions
    func set_avgDuration(x$) self.avgDuration := Val(x$) end;
    func get_avgDuration(col%, row%) get(col%, row%); set_avgDuration(self.temp$); end;
    func write_avgDuration(col%, row%) return write(Str$(self.avgDuration), col%, row%) end;
    
    func set_waveSamples() self.waveSamples% := self.avgDuration * (1.0/BinSize(self.waveChan%)); end;
    
    '' nBins functions
    func set_nbins(x$) self.nbins% := Val(x$) end;
    func get_nbins(col%, row%) get(col%, row%); set_nbins(self.temp$); end;
    func write_nbins(col%, row%) return write(Str$(self.nbins%), col%, row%) end;
    
    '' ptshDuration functions
    func set_psthDuration(x$) self.psthDuration := Val(x$) end;
    func get_psthDuration(col%, row%) get(col%, row%); set_psthDuration(self.temp$); end;
    func write_psthDuration(col%, row%) return write(Str$(self.psthDuration), col%, row%) end;
    
    '' c12 functions
    func set_c12(x$) self.c12% := Val(x$) end;
    func get_c12(col%, row%) get(col%, row%); set_c12(self.temp$); end;
    func write_c12(col%, row%) return write(Str$(self.c12%), col%, row%) end;
    
    '' c34 functions
    func set_c34(x$) self.c34% := Val(x$) end;
    func get_c34(col%, row%) get(col%, row%); set_c34(self.temp$); end;
    func write_c34(col%, row%) return write(Str$(self.c34%), col%, row%) end;
    
    '' c56 functions
    func set_c56(x$) self.c56% := Val(x$) end;
    func get_c56(col%, row%) get(col%, row%); set_c56(self.temp$); end;
    func write_c56(col%, row%) return write(Str$(self.c56%), col%, row%) end;
    
    '' c78 functions
    func set_c78(x$) self.c78% := Val(x$) end;
    func get_c78(col%, row%) get(col%, row%); set_c78(self.temp$); end;
    func write_c78(col%, row%) return write(Str$(self.c78%), col%, row%) end;
    
    '' c90 functions
    func set_c90(x$) self.c90% := Val(x$) end;
    func get_c90(col%, row%) get(col%, row%); set_c90(self.temp$); end;
    func write_c90(col%, row%) return write(Str$(self.c90%), col%, row%) end;
    
    '' c90 functions
    func set_version(x$) self.version$ := x$ end;
    func get_version(col%, row%) get(col%, row%); set_version(self.temp$); end;
    func write_version(col%, row%) return write(self.version$, col%, row%) end;
    
    func set_waveAvgFlag(x$) self.waveAvgFlag% := Val(x$) end;
    func get_waveAvgFlag(col%, row%) get(col%, row%); set_waveAvgFlag(self.temp$); end;
    func write_waveAvgFlag(col%, row%) return write(Str$(self.waveAvgFlag%), col%, row%) end;
    
    func set_psthFlag(x$) self.psthFlag% := Val(x$) end;
    func get_psthFlag(col%, row%) get(col%, row%); set_psthFlag(self.temp$); end;
    func write_psthFlag(col%, row%) return write(Str$(self.psthFlag%), col%, row%) end;
    
    func set_stimAvgFlag(x$) self.stimAvgFlag% := Val(x$) end;
    func get_stimAvgFlag(col%, row%) get(col%, row%); set_stimAvgFlag(self.temp$); end;
    func write_stimAvgFlag(col%, row%) return write(Str$(self.stimAvgFlag%), col%, row%) end;
    
    
    '' 
    func readAll()
    var row% := 0;
    var col% := 1;
    get_folder(col%, row%);
    row% += 1;
    get_db(col%, row%);
    row% += 1;
    get_Hz(col%, row%);
    row% += 1;
    get_msPD(col%, row%);
    row% += 1;
    get_pulses(col%, row%);
    row% += 1;
    get_pps(col%, row%);
    row% += 1;
    get_nA(col%, row%);
    row% += 1;
    get_stimTrigChan(col%, row%);
    row% += 1;
    get_spksTrigChan(col%, row%);
    row% += 1;
    get_stimChan(col%, row%);
    row% += 1;
    get_waveChan(col%, row%);
    row% += 1;
    get_avgDuration(col%, row%);
    row% += 1;
    get_nbins(col%, row%);
    row% += 1;
    get_psthDuration(col%, row%);
    row% += 1;
    get_c12(col%, row%);
    row% += 1;
    get_c34(col%, row%);
    row% += 1;
    get_c56(col%, row%);
    row% += 1;
    get_c78(col%, row%);
    row% += 1;
    get_c90(col%, row%);
    row% += 1;
    get_version(col%, row%);
    row% += 1;
    get_waveAvgFlag(col%, row%);
    row% += 1;
    get_psthFlag(col%, row%);
    row% += 1;
    get_stimAvgFlag(col%, row%);
    end
    
    func writeAll()
    var row% := 0;
    var col% := 1;
    write_folder(col%, row%);
    row% += 1;
    write_db(col%, row%);
    row% += 1;
    write_Hz(col%, row%);
    row% += 1;
    write_msPD(col%, row%);
    row% += 1;
    write_pulses(col%, row%);
    row% += 1;
    write_pps(col%, row%);
    row% += 1;
    write_nA(col%, row%);
    row% += 1;
    write_stimTrigChan(col%, row%);
    row% += 1;
    write_spksTrigChan(col%, row%);
    row% += 1;
    write_stimChan(col%, row%);
    row% += 1;
    write_waveChan(col%, row%);
    row% += 1;
    write_avgDuration(col%, row%);
    row% += 1;
    write_nbins(col%, row%);
    row% += 1;
    write_psthDuration(col%, row%);
    row% += 1;
    write_c12(col%, row%);
    row% += 1;
    write_c34(col%, row%);
    row% += 1;
    write_c56(col%, row%);
    row% += 1;
    write_c78(col%, row%);
    row% += 1;
    write_c90(col%, row%);
    row% += 1;
    write_version(col%, row%);
    row% += 1;
    write_waveAvgFlag(col%, row%);
    row% += 1;
    write_psthFlag(col%, row%);
    row% += 1;
    write_stimAvgFlag(col%, row%);
    end
    
    func buildAvgSaveName$()
    var saveName$ := Str$(self.dB%)+"dB_"+Str$(self.Hz%)+"Hz_"+Str$(self.msPD%)+"msPD_"+Str$(self.pulses%)+"pulses_"+Str$(self.pps%)+"pps_"+Str$(self.nA)+"nA_v"+self.version$;
    return saveName$;
    end
    
    func buildPSTHSaveName$()
    var saveName$ := self.buildAvgSaveName$()+"_psth";
    return saveName$;
    end
    
    func buildStimSaveName$()
    var saveName$ := self.buildAvgSaveName$()+"_stimulus";
    return saveName$;
    end
    
    func print()
    PrintLog("Setting File: "+self.path$+"\\"+self.name$+" \n");
    PrintLog("Attenuation: "+Str$(self.dB%)+" dB \n");
    PrintLog("Carrier Frequency: "+Str$(self.Hz%)+" Hz \n");
    PrintLog("Pulse Duration: "+Str$(self.msPD%)+" msec \n");
    PrintLog("Pulse Rate: "+Str$(self.pps%)+" pps \n");
    PrintLog("Injected Current: "+Str$(self.nA)+" nA \n");
    PrintLog("Stimulus Trigger Channel: "+Str$(self.stimTrigChan%)+" \n");
    PrintLog("Spikes Trigger Channel: "+Str$(self.spksTrigChan%)+" \n");
    PrintLog("Stimulus Channel: "+Str$(self.stimChan%)+" \n");
    PrintLog("Wave Channel: "+Str$(self.waveChan%)+" \n");
    PrintLog("Average Duration: "+Str$(self.avgDuration)+" secs \n");
    PrintLog("PSTH bins: "+Str$(self.nbins%)+" \n");
    PrintLog("PSTH duration: "+Str$(self.psthDuration)+" secs \n");
    PrintLog("Cursor 1-2: "+Str$(self.c12%)+" \n");
    PrintLog("Cursor 3-4: "+Str$(self.c34%)+" \n");
    PrintLog("Cursor 5-6: "+Str$(self.c56%)+" \n");
    PrintLog("Cursor 7-8: "+Str$(self.c78%)+" \n");
    PrintLog("Cursor 9-0: "+Str$(self.c90%)+" \n");
    PrintLog("File Version: "+self.version$+" \n");
    PrintLog("Folder: "+self.folder$+" \n");
    PrintLog("Make Waveform Average: "+Str$(self.waveAvgFlag%)+" \n");
    PrintLog("Make PSTH: "+Str$(self.psthFlag%)+" \n");
    PrintLog("Make Stimulus Average: "+Str$(self.stimAvgFlag%)+" \n");
    end
    
    func createAverage%()
    self.waveAvgView% := SetAverage(self.waveChan%, self.waveSamples%, 0, self.stimTrigChan%, 1, 1);
    FrontView(self.view%);
    if self.c12% = 1 then
        Process(View(-1).Cursor(1), View(-1).Cursor(2), 0, 1);
    endif
    if self.c34% = 1 then
        Process(View(-1).Cursor(3), View(-1).Cursor(4), 0, 1);
    endif
    if self.c56% = 1 then
        Process(View(-1).Cursor(5), View(-1).Cursor(6), 0, 1);
    endif
    if self.c78% = 1 then
        Process(View(-1).Cursor(7), View(-1).Cursor(8), 0, 1);
    endif
    if self.c90% = 1 then
        Process(View(-1).Cursor(9), View(-1).Cursor(0), 0, 1);
    endif
    FrontView(self.waveAvgView%);
    end
    
    func createStimAverage%()
    self.stimAvgView% := SetAverage(self.stimChan%, self.waveSamples%, 0, self.stimTrigChan%, 1, 1);
    FrontView(self.view%);
    if self.c12% = 1 then
        Process(View(-1).Cursor(1), View(-1).Cursor(2), 0, 1);
    endif
    if self.c34% = 1 then
        Process(View(-1).Cursor(3), View(-1).Cursor(4), 0, 1);
    endif
    if self.c56% = 1 then
        Process(View(-1).Cursor(5), View(-1).Cursor(6), 0, 1);
    endif
    if self.c78% = 1 then
        Process(View(-1).Cursor(7), View(-1).Cursor(8), 0, 1);
    endif
    if self.c90% = 1 then
        Process(View(-1).Cursor(9), View(-1).Cursor(0), 0, 1);
    endif
    FrontView(self.stimAvgView%);
    end
    
    
    func createPSTH%()
    var binDuration := self.avgDuration/self.nbins%;
    self.psthView% := SetPsth(self.spksTrigChan%, self.nbins%, binDuration, 0, self.stimTrigChan%, 2);
    FrontView(self.psthView%);
    if self.c12% = 1 then
        Process(View(-1).Cursor(1), View(-1).Cursor(2), 0, 1);
    endif
    if self.c34% = 1 then
        Process(View(-1).Cursor(3), View(-1).Cursor(4), 0, 1);
    endif
    if self.c56% = 1 then
        Process(View(-1).Cursor(5), View(-1).Cursor(6), 0, 1);
    endif
    if self.c78% = 1 then
        Process(View(-1).Cursor(7), View(-1).Cursor(8), 0, 1);
    endif
    if self.c90% = 1 then
        Process(View(-1).Cursor(9), View(-1).Cursor(0), 0, 1);
    endif
    FrontView(self.psthView%) ;
    end
    
    func createAnalysisChoiceDlg%()
    var idx% := 1;
    DlgCreate("Analysis Choice");
    DlgCheck(idx%, "Waveform Average");
    idx% += 1;
    DlgCheck(idx%, "PSTH");
    idx% += 1;
    DlgCheck(idx%, "Stimulus");
    idx% += 1;
    var ok% := DlgShow(self.waveAvgFlag%, self.psthFlag%, self.stimAvgFlag%);
    return ok%;
    end
    
    func createAnalysisDlg%()
    var idx% := 1;
    var waveChanType% := 1;
    var eventChanType% := 2;
    DlgCreate("Analysis Settings");
    DlgChan(idx%, "Waveform Channel", waveChanType%);
    idx% += 1;
    DlgChan(idx%, "Stimulus Channel", waveChanType%);
    idx% += 1;
    DlgChan(idx%, "Stimulus Trigger Channel", eventChanType%);
    idx% += 1;
    DlgChan(idx%, "Spike Trigger Channel", eventChanType%);
    idx% += 1;
    DlgXValue(idx%, "Duration for Average (secs)");
    idx% += 1;
    DlgCheck(idx%, "Include Cursor Region 1-2");
    idx% += 1;
    DlgCheck(idx%, "Include Cursor Region 3-4");
    idx% += 1;
    DlgCheck(idx%, "Include Cursor Region 5-6");
    idx% += 1;
    DlgCheck(idx%, "Include Cursor Region 7-8");
    idx% += 1;
    DlgCheck(idx%, "Include Cursor Region 9-0");
    idx% += 1;
    DlgInteger(idx%, "PSTH Bins", 1, 10000);
    idx% += 1;
    DlgXValue(idx%, "PSTH Duration (secs)");
    idx% += 1;
    DlgInteger(idx%, "Stimulus Attenuation(dB)", -100, 0);
    idx% += 1;
    DlgInteger(idx%, "Stimulus Carrier Frequency (Hz)", 1, 5000);
    idx% += 1;
    DlgInteger(idx%, "Stimulus Pulse Duration (msec)", 1, 1000);
    idx% += 1;
    DlgInteger(idx%, "Number of Pulses", 1, 200);
    idx% += 1;
    DlgInteger(idx%, "Pulse Rate (pps)", 1, 200);
    idx% += 1;
    DlgReal(idx%, "Injected Current (nA)", -1, 1);
    idx% += 1;
    DlgString(idx%, "Version", 256);
    idx% += 1;
    DlgString(idx%, "Results Subfolder", 256);
    var ok% := DlgShow(
        self.waveChan%,
        self.stimChan%, 
        self.stimTrigChan%, 
        self.spksTrigChan%, 
        self.avgDuration, 
        self.c12%, 
        self.c34%, 
        self.c56%, 
        self.c78%, 
        self.c90%, 
        self.nbins%, 
        self.psthDuration, 
        self.dB%, 
        self.Hz%, 
        self.msPD%, 
        self.pulses%, 
        self.pps%, 
        self.nA, 
        self.version$, 
    self.folder$);
    if ok% = 1 then
        self.set_waveSamples();
    endif
    return ok%
    end

ObjEnd    