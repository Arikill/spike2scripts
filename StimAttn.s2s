#include "libs/TrigsObj.s2s"
#include "libs/FileObj.s2s"
#include "libs/ChanFuncs.s2s"

var FileObj file;
file.setName(FileName$(3));
file.bringToFront();

var TrigsObj stimTrigs;
stimTrigs.setChan(2);
stimTrigs.setStartEvent(0.0);
stimTrigs.setEndEvent(MaxTime());

var speaker$ := "W";

var stimChan% := 1;
var attnValue% := 0;

var maxAmplitude := 1;
var refAmplitude := 2;

var nextStimEvent := -1;

DlgCreate("Stimulus Attenuation in dB");
DlgChan(1, "Stimulus Channel", 1);
DlgChan(2, "Stimulus Triggers Channel", 2);
DlgXValue(3, "Start Time");
DlgXValue(4, "End Time");
DlgString(5, "Speaker (eg: W for West)", 1);

var ok% := DlgShow(stimChan%, stimTrigs.chan%, stimTrigs.start_event, stimTrigs.end_event, speaker$);

if ok% = 1 then
    var attenMarkerChan% := createMarkerChannel("Attn("+speaker$+"): ");
    stimTrigs.setStartEvent(stimTrigs.start_event-BinSize(stimTrigs.chan%));
    stimTrigs.setEndEvent(stimTrigs.end_event-BinSize(stimTrigs.chan%));
    while stimTrigs.start_event <= stimTrigs.end_event do
        nextStimEvent := NextTime(stimTrigs.chan%, stimTrigs.start_event);
        if nextStimEvent < 0 then
            break;
        endif
        maxAmplitude := ChanMeasure(stimChan%, 13, stimTrigs.start_event, nextStimEvent);
        attnValue% := -21+Round(20*Log(Abs(2*maxAmplitude)/refAmplitude)/3)*3;
        MemSetItem(attenMarkerChan%, 0, stimTrigs.start_event, 0, Str$(attnValue%));
        if stimTrigs.getNext() < 0 then
            break;
        endif
    wend
    
endif